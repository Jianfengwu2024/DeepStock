# Copy this file to .env. Local Windows runs bind only to loopback. On Linux,
# configure an authenticated reverse proxy before changing the bind address.

# User-level systemd service managed by start.sh and stop.sh.
BNHMM_SERVICE_NAME=bnhmm-web.service

# Web bind address and the local address used by health checks.
BNHMM_WEB_HOST=127.0.0.1
BNHMM_WEB_HEALTH_HOST=127.0.0.1
BNHMM_WEB_PORT=8765

# Leave empty to let start.sh discover the server's public IP automatically.
BNHMM_PUBLIC_HOST=

# Keep generated runs outside this source repository.
BNHMM_WEB_JOB_ROOT=/home/wujianfeng/private/bnhmm-storage/ui-runs
BNHMM_MARKET_SOURCE=http://127.0.0.1:9000/api/v1/db
BNHMM_DEFAULT_DEVICE=auto
BNHMM_QUANT_SERVER=https://quant.hapgetaquant.com
# Supply BNHMM_QUANT_ACCESS_TOKEN only in the process environment when needed.
# Do not save user sessions or broker secrets in this file.

# Optional path overrides. Uncomment them only when the deployment layout differs.
# BNHMM_PROJECT_ROOT=/home/wujianfeng/private/bnhmm-engine
# BNHMM_SECTOR_DATASET_ROOT=/home/share/data/sectors
# BNHMM_VISUAL_DATASET_ROOT=/home/wujianfeng/private/bnhmm-storage/visual-datasets/semiconductor-2024-2025
# BNHMM_BOUNDARY_CACHE_ROOT=/home/wujianfeng/private/bnhmm-storage/path-efficiency-data
