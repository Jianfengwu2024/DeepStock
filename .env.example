# Copy this file to .env, then adjust the values for the deployment host.
# The systemd unit's EnvironmentFile path must point to the copied .env file.

# User-level systemd service managed by start.sh and stop.sh.
BNHMM_SERVICE_NAME=bnhmm-web.service

# Web bind address and the local address used by health checks.
BNHMM_WEB_HOST=0.0.0.0
BNHMM_WEB_HEALTH_HOST=127.0.0.1
BNHMM_WEB_PORT=8765

# Leave empty to let start.sh discover the server's public IP automatically.
BNHMM_PUBLIC_HOST=

# Keep generated runs outside this source repository.
BNHMM_WEB_JOB_ROOT=/home/lisa/deep_stock-storage/ui-runs

# Optional path overrides. Uncomment them only when the deployment layout differs.
# BNHMM_PROJECT_ROOT=/home/lisa/deep_stock
# BNHMM_SECTOR_DATASET_ROOT=/home/share/data/sectors
# BNHMM_VISUAL_DATASET_ROOT=/home/lisa/deep_stock-storage/visual-datasets/semiconductor-2024-2025
# BNHMM_BOUNDARY_CACHE_ROOT=/home/lisa/deep_stock-storage/path-efficiency-data
